{
  "name": "billmaster",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "lsof -ti:5173,5001,8000 | xargs kill -9 2>/dev/null || true",
    "dev:frontend": "vite",
    "dev:backend": "cd server && npm run dev",
    "dev:ml": "cd ml-service && (python3 -m uvicorn main:app --reload --port 8000 || python -m uvicorn main:app --reload --port 8000)",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:ml\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "install:all": "npm install && cd server && npm install",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "axios": "^1.16.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "ogl": "^1.0.11",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
