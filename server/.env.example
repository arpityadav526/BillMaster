# ========== BILLMASTER SERVER — ENVIRONMENT VARIABLES ==========
# Copy this file to .env and fill in your values

# Server port (5001 avoids conflicts with common dev tools)
PORT=5001
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/billmaster

# JWT secret (change this to a long random string in production!)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL (Vite default dev port)
CLIENT_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# MAILER / SMTP (Gmail, Resend, SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@billmaster.com

# Cloudinary (optional — for cloud avatar hosting)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ========== Gmail OAuth 2.0 (Automatic Expense Tracking) ==========
# Create a project at https://console.cloud.google.com
# Enable the Gmail API and create OAuth 2.0 credentials
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REDIRECT_URI=http://localhost:5001/api/gmail/callback
